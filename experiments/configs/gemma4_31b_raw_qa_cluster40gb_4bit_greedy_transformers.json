{
  "name": "gemma4-31b-cluster40gb-4bit-greedy-raw-qa-transformers",
  "description": "Gemma 4 31B raw_qa run using 4-bit bitsandbytes loading on one 40GB CUDA GPU.",
  "hypothesis": "Gemma 4 31B is the largest Gemma candidate likely to fit on a 40GB GPU in 4-bit.",
  "tags": [
    "baseline",
    "raw_qa",
    "gemma4",
    "31b",
    "cluster40gb",
    "4bit",
    "transformers"
  ],
  "model": {
    "type": "gemma4",
    "path": "google/gemma-4-31B-it",
    "backend": "transformers",
    "inference_config": "experiments/configs/gemma4_31b_cluster40gb_4bit_reasoning_inference.json"
  },
  "data": {
    "split": "tinybench",
    "task": "raw_qa",
    "input_file": "data/prompts/general/MindCube_tinybench_raw_qa.jsonl",
    "image_root": "./data/"
  },
  "generation": {
    "batch_size": 1,
    "max_new_tokens": 512,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "evaluation": {
    "mode": "basic"
  }
}
