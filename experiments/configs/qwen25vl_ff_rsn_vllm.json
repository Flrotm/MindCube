{
  "name": "qwen25vl_ff_rsn_vllm",
  "description": "Free-form reasoning prompt using Qwen2.5-VL with the vLLM config on Kaggle.",
  "hypothesis": "Adding explicit reasoning may improve spatial answer accuracy compared with raw QA.",
  "tags": ["reasoning", "ff_rsn", "qwen2.5-vl", "vllm"],
  "model": {
    "type": "qwen2.5vl",
    "path": "Qwen/Qwen2.5-VL-3B-Instruct",
    "backend": "vllm",
    "inference_config": "configs/vllm_optimized.json"
  },
  "data": {
    "split": "tinybench",
    "task": "ff_rsn",
    "input_file": "data/prompts/general/MindCube_tinybench_ff_rsn.jsonl",
    "image_root": "./data/"
  },
  "generation": {
    "batch_size": 1,
    "max_new_tokens": 1024,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "evaluation": {
    "mode": "auto"
  }
}
